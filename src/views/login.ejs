<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof titulo !== 'undefined' ? titulo : 'PriorityParking - Login Alumnos' %></title>
    <link rel="stylesheet" href="/css/login.css">
</head>
<body>

    <div class="login-card">
        <div class="logo-title">🚗 PriorityParking</div>
        <div class="subtitle">Acceso Exclusivo para Alumnos UTP</div>
        
        <div id="alertBox" class="alert hidden"></div>

        <div id="groupEmail">
            <div class="form-group">
                <label for="correo">Correo Institucional</label>
                <input type="email" id="correo" placeholder="U22XXXXX@utp.edu.pe">
            </div>
            <button id="btnSolicitarOtp" type="button">Solicitar Token OTP</button>
        </div>

        <div id="groupOtp" class="hidden">
            <div class="form-group">
                <label for="otp">Código de Verificación (6 dígitos)</label>
                <input type="text" id="otp" class="input-otp" placeholder="Ej: 543210" maxlength="6">
            </div>
            <button id="btnVerificarOtp" type="button" class="btn-validar">Validar Código e Ingresar</button>
        </div>
    </div>

    <script src="/js/login.js"></script>
</body>
</html>