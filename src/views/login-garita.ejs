<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof titulo !== 'undefined' ? titulo : 'PriorityParking - Acceso Garita' %></title>
    <link rel="stylesheet" href="/css/login-garita.css">
</head>
<body>

    <div class="login-card">
        <div class="logo-title">👮 Control Garita</div>
        <div class="subtitle">Sistemas Internos de Seguridad - UTP</div>
        
        <div id="alertBox" class="alert hidden"></div>

        <div class="form-group">
            <label for="usuario">Credencial Operador</label>
            <input type="text" id="usuario" placeholder="Ej: UTP-GARITA">
        </div>
        <div class="form-group">
            <label for="password">Clave de Seguridad</label>
            <input type="password" id="password" placeholder="••••••••">
        </div>
        <button id="btnIngresarGarita" type="button">Ingresar al Monitor</button>

        <div class="switch-login">
            <p>Otros accesos del sistema</p>
            <div class="switch-links">
                <a href="/login" id="link-login-alumnos">&larr; Alumnos (OTP)</a>
                <span class="divider">|</span>
                <a href="/login-admin" id="link-login-admin">Administrador &rarr;</a>
            </div>
        </div>
    </div>

    <script src="/js/login-garita.js"></script>
</body>
</html>