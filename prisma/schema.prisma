generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EstudianteHabilitado {
  idEstudiante           Int                     @id @default(autoincrement()) @map("id_estudiante")
  codigoAlumno           String                  @unique @map("codigo_alumno") @db.VarChar(15)
  correoInstitucional    String                  @unique @map("correo_institucional") @db.VarChar(100)
  nombreCompleto         String                  @map("nombre_completo") @db.VarChar(150)
  estaAlDiaPagos         Boolean?                @default(true) @map("esta_al_dia_pagos")
  porcentajeAsistencia   Decimal                 @map("porcentaje_asistencia") @db.Decimal(5, 2)
  promedioPonderado      Decimal                 @map("promedio_ponderado") @db.Decimal(4, 2)
  esAptoParking          Boolean?                @default(dbgenerated("((esta_al_dia_pagos = true) AND (porcentaje_asistencia >= 70.00) AND (promedio_ponderado >= 14.00))")) @map("es_apto_parking")
  ultimaActualizacionEtl DateTime?               @default(now()) @map("ultima_actualizacion_etl") @db.Timestamp(6)
  penalizaciones         HistorialPenalizacion[]
  otps                   RegistroOtp[]
  reservas               Reserva[]

  @@index([correoInstitucional], map: "idx_estudiantes_correo")
  @@map("estudiantes_habilitados")
}

model EspacioEstacionamiento {
  idEspacio    String    @id @map("id_espacio") @db.VarChar(10)
  piso         Int
  numeroSlot   Int       @map("numero_slot")
  estado       String?   @default("DISPONIBLE") @db.VarChar(20)
  tipoVehiculo String?   @default("AUTO") @map("tipo_vehiculo") @db.VarChar(20)
  reservas     Reserva[]

  @@map("espacios_estacionamiento")
}

model Reserva {
  idReserva             Int                     @id @default(autoincrement()) @map("id_reserva")
  codigoAlumno          String?                 @map("codigo_alumno") @db.VarChar(15)
  idEspacio             String?                 @map("id_espacio") @db.VarChar(10)
  codigoOtpUsado        String                  @map("codigo_otp_usado") @db.VarChar(6)
  fechaReserva          DateTime                @map("fecha_reserva") @db.Date
  horaLlegadaProgramada DateTime?               @default(dbgenerated("CURRENT_TIME")) @map("hora_llegada_programada") @db.Time(6)
  fechaSolicitud        DateTime?               @default(dbgenerated("CURRENT_DATE")) @map("fecha_solicitud") @db.Date
  estadoReserva         String?                 @default("PENDIENTE") @map("estado_reserva") @db.VarChar(20)
  estudiante            EstudianteHabilitado?   @relation(fields: [codigoAlumno], references: [codigoAlumno], onDelete: NoAction, onUpdate: NoAction)
  espacio               EspacioEstacionamiento? @relation(fields: [idEspacio], references: [idEspacio], onDelete: NoAction, onUpdate: NoAction)

  @@unique([codigoAlumno, fechaReserva], name: "unica_reserva_por_dia_alumno", map: "unica_reserva_por_dia_alumno")
  @@map("reservas")
}

model HistorialPenalizacion {
  idPenalizacion Int                   @id @default(autoincrement()) @map("id_penalizacion")
  codigoAlumno   String?               @map("codigo_alumno") @db.VarChar(15)
  motivo         String                @db.VarChar(255)
  fechaInicio    DateTime?             @default(now()) @map("fecha_inicio") @db.Timestamp(6)
  fechaFin       DateTime              @map("fecha_fin") @db.Timestamp(6)
  activa         Boolean?              @default(true)
  estudiante     EstudianteHabilitado? @relation(fields: [codigoAlumno], references: [codigoAlumno], onDelete: Cascade, onUpdate: NoAction)

  @@map("historial_penalizaciones")
}

model RegistroOtp {
  idOtp           Int                   @id @default(autoincrement()) @map("id_otp")
  codigoAlumno    String?               @map("codigo_alumno") @db.VarChar(15)
  codigoOtp       String                @map("codigo_otp") @db.VarChar(6)
  fechaGeneracion DateTime?             @default(now()) @map("fecha_generacion") @db.Timestamp(6)
  expirado        Boolean?              @default(false)
  estudiante      EstudianteHabilitado? @relation(fields: [codigoAlumno], references: [codigoAlumno], onDelete: Cascade, onUpdate: NoAction)

  @@map("registro_otp")
}
